<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Do not inherit an old Visual Studio fallback folder that is absent on this machine. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
